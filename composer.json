{
  "name": "tusharkhan/db-error-explainer-core",
  "description": "Explains PDO database errors in plain language with a suggested SQL fix, for MySQL, MariaDB, PostgreSQL and SQLite",
  "keywords": [
    "database",
    "error",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "pdo",
    "debugging",
    "diagnosis"
  ],
  "homepage": "https://github.com/tusharkhan/db-error-explainer-core",
  "license": "MIT",
  "authors": [
    {
      "name": "Tushar Khan",
      "email": "tushar.khan0122@gmail.com"
    }
  ],
  "type": "library",
  "support": {
    "issues": "https://github.com/tusharkhan/db-error-explainer-core/issues",
    "source": "https://github.com/tusharkhan/db-error-explainer-core"
  },
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "psr/log": "^3.0",
    "tusharkhan/db-error-explainer-lib": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../lib",
      "options": {
        "symlink": true,
        "versions": {
          "tusharkhan/db-error-explainer-lib": "1.0.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "TusharKhan\\DbErrorExplainer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Unit\\": "tests/Unit/",
      "Integration\\": "tests/Integration/",
      "Support\\": "tests/Support/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
