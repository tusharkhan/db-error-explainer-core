{
  "name": "tusharkhan/db-error-explainer-core",
  "description": "Framework-agnostic PHP library for analyzing and explaining database errors with actionable insights",
  "keywords": ["database", "error", "mysql", "pdo", "debugging", "diagnosis"],
  "homepage": "https://github.com/tusharkhan/db-error-explainer-core",
  "license": "MIT",
  "authors": [
    {
      "name": "Tushar Khan",
      "email": "tushar.khan0122@gmail.com"
    }
  ],
  "type": "library",
  "support": {
    "issues": "https://github.com/tusharkhan/db-error-explainer-core/issues",
    "source": "https://github.com/tusharkhan/db-error-explainer-core"
  },
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "TusharKhan\\DbErrorExplainer\\": "src/",
      "TusharKhan\\DbErrorExplainer\\Lib\\": "../../Lib/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

